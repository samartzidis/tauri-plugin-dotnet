<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Tauri.Plugin.DotNet NuGet package build targets.
    Auto-imported when a consumer adds <PackageReference Include="Tauri.Plugin.DotNet" />.

    This file:
    1. Copies the TypeScript bridge runtime to the frontend's bindings folder.
    2. Runs the binding generator against the consumer's compiled assembly.
    3. Creates the empty src-tauri\backend folder that Tauri requires to exist (see TauriDotNetResourceFolder).

    The dev-only sidecar host (`backend!`/`sidecar_backend_host!` in a debug build) needs no build-time step
    from this file: it generates its own small wrapper project referencing the backend's .csproj directly
    and runs it under `dotnet watch` (see src/sidecar.rs and src/sidecar/wrapper.rs in the crate).

    Building and bundling the frontend is left to Tauri (beforeDevCommand / beforeBuildCommand).

    Configurable properties (set in the consumer's .csproj before this import):
      $(TauriDotNetOutputDir)                - Where to place runtime.ts and the generated .ts files.
                                               Relative to the project directory. The default assumes the
                                               usual layout: src-dotnet\MyApp.Backend\ next to src\
                                               (default: ..\..\src\bindings)
      $(TauriDotNetSkipBindingGeneration)    - Set to 'true' to skip binding generation
      $(TauriDotNetGeneratorCommand)         - The command that runs the generator (binding generation and the optional
                                               bundling), for developing this package itself: the tool then runs from
                                               source instead of from the package.
                                               (default: dotnet "<package>\tools\net8.0\Tauri.Plugin.DotNet.Generator.dll")
      $(TauriDotNetResourceFolder)           - The folder `bundle.resources` ships (where `tauri build` puts the Release
                                               backend), relative to the project directory. A Debug build creates it, empty,
                                               if its parent exists, because Tauri needs it to exist to compile
                                               (default: ..\..\src-tauri\backend)
      $(TauriDotNetSkipResourceFolder)       - Set to 'true' to never create that folder

    Optional: embedding the backend in the Tauri executable (off by default)
      $(TauriDotNetEmbed)                    - Set to 'true' (for example dotnet build -p:TauriDotNetEmbed=true) to
                                               also write a backend bundle after the build. The Tauri app embeds it
                                               with HostfxrOptions::embedded(include_bytes!(...)), so no backend
                                               file has to ship next to the executable.
      $(TauriDotNetBundlePath)               - Where to write the bundle. Relative to the project directory.
                                               (default: <output folder>\<AssemblyName>.tdnbundle)
  -->

  <PropertyGroup>
    <TauriDotNetOutputDir Condition="'$(TauriDotNetOutputDir)' == ''">..\..\src\bindings</TauriDotNetOutputDir>
    <_TauriDotNetPkgDir>$(MSBuildThisFileDirectory)..\</_TauriDotNetPkgDir>
    <!-- The generator's own target framework (packed under tools\<tfm>\), not the consumer's. Keep in sync with the package's csproj. -->
    <_TauriDotNetToolTfm>net8.0</_TauriDotNetToolTfm>
    <!-- Exec takes a raw command string, so paths passed to it are normalized to the OS separator -->
    <_TauriDotNetGeneratorDll>$([MSBuild]::NormalizePath('$(_TauriDotNetPkgDir)', 'tools', '$(_TauriDotNetToolTfm)', 'Tauri.Plugin.DotNet.Generator.dll'))</_TauriDotNetGeneratorDll>
    <_TauriDotNetOutputDirFull>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TauriDotNetOutputDir)'))</_TauriDotNetOutputDirFull>
    <TauriDotNetResourceFolder Condition="'$(TauriDotNetResourceFolder)' == ''">..\..\src-tauri\backend</TauriDotNetResourceFolder>
    <_TauriDotNetResourceFolderFull>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TauriDotNetResourceFolder)'))</_TauriDotNetResourceFolderFull>
  </PropertyGroup>

  <!--
    Copy runtime.ts to the bindings output dir. It is copied when missing and again whenever its
    last-write time differs from the package's copy (a copy keeps the time, and any edit or a newer package
    changes it), so upgrading the package refreshes it and the generated files always match it.
  -->
  <Target Name="TauriDotNetCopyRuntime"
          BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_TauriDotNetRuntimeSrc>$([MSBuild]::NormalizePath('$(_TauriDotNetPkgDir)', 'content', 'bridge', 'runtime.ts'))</_TauriDotNetRuntimeSrc>
      <_TauriDotNetRuntimeDst>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TauriDotNetOutputDir)', 'runtime.ts'))</_TauriDotNetRuntimeDst>
      <_TauriDotNetRuntimeStale>true</_TauriDotNetRuntimeStale>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(_TauriDotNetRuntimeDst)')">
      <_TauriDotNetRuntimeStale Condition="$([System.IO.File]::GetLastWriteTime('$(_TauriDotNetRuntimeSrc)').Ticks) == $([System.IO.File]::GetLastWriteTime('$(_TauriDotNetRuntimeDst)').Ticks)">false</_TauriDotNetRuntimeStale>
    </PropertyGroup>
    <MakeDir Condition="'$(_TauriDotNetRuntimeStale)' == 'true'" Directories="$(TauriDotNetOutputDir)" />
    <Copy Condition="'$(_TauriDotNetRuntimeStale)' == 'true'"
          SourceFiles="$(_TauriDotNetRuntimeSrc)"
          DestinationFiles="$(_TauriDotNetRuntimeDst)"
          OverwriteReadOnlyFiles="true" />
    <Message Condition="'$(_TauriDotNetRuntimeStale)' == 'true'" Importance="high" Text="[Tauri.Plugin.DotNet] Updated bridge runtime at $(TauriDotNetOutputDir)\runtime.ts" />
  </Target>

  <!-- The command that runs the generator: TauriDotNetGeneratorCommand if set, otherwise the tool from the package -->
  <Target Name="_TauriDotNetResolveGenerator">
    <PropertyGroup>
      <_TauriDotNetGenerator>$(TauriDotNetGeneratorCommand)</_TauriDotNetGenerator>
      <_TauriDotNetGenerator Condition="'$(_TauriDotNetGenerator)' == ''">dotnet &quot;$(_TauriDotNetGeneratorDll)&quot;</_TauriDotNetGenerator>
    </PropertyGroup>
  </Target>

  <!-- Run the binding generator after build -->
  <Target Name="TauriDotNetGenerateBindings"
          AfterTargets="Build"
          DependsOnTargets="_TauriDotNetResolveGenerator"
          Condition="'$(TauriDotNetSkipBindingGeneration)' != 'true'">
    <Exec Command="$(_TauriDotNetGenerator) &quot;$(TargetPath)&quot; &quot;$(_TauriDotNetOutputDirFull)&quot;" />
    <Message Importance="high" Text="[Tauri.Plugin.DotNet] Generated TypeScript bindings in $(TauriDotNetOutputDir)" />
  </Target>

  <!--
    Development setup for the Tauri layout: `bundle.resources` maps the folder that `tauri build` puts the
    Release backend into (src-tauri\backend), and Tauri requires every resource path to exist whenever the app
    is compiled, `tauri dev` included, although `tauri dev` itself never writes there. Create it (empty) on the
    first Debug build, which `beforeDevCommand` runs before cargo, so nothing has to be kept in git for it.
    Does nothing outside a Tauri layout (no src-tauri folder next to the project) or when the folder exists.
  -->
  <Target Name="TauriDotNetEnsureResourceFolder"
          BeforeTargets="BeforeBuild"
          Condition="'$(Configuration)' == 'Debug' AND '$(TauriDotNetSkipResourceFolder)' != 'true' AND Exists('$([System.IO.Path]::GetDirectoryName($(_TauriDotNetResourceFolderFull)))') AND !Exists('$(_TauriDotNetResourceFolderFull)')">
    <MakeDir Directories="$(_TauriDotNetResourceFolderFull)" />
  </Target>

  <!-- Opt-in: pack the built backend (assemblies, symbols, runtime config) into one file the app can embed -->
  <Target Name="TauriDotNetBundleBackend"
          AfterTargets="Build"
          DependsOnTargets="_TauriDotNetResolveGenerator"
          Condition="'$(TauriDotNetEmbed)' == 'true'">
    <PropertyGroup>
      <_TauriDotNetBundlePath Condition="'$(TauriDotNetBundlePath)' != ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TauriDotNetBundlePath)'))</_TauriDotNetBundlePath>
      <_TauriDotNetBundlePath Condition="'$(_TauriDotNetBundlePath)' == ''">$(TargetDir)$(TargetName).tdnbundle</_TauriDotNetBundlePath>
    </PropertyGroup>
    <Exec Command="$(_TauriDotNetGenerator) bundle &quot;$(TargetPath)&quot; &quot;$(_TauriDotNetBundlePath)&quot;" />
  </Target>

</Project>
