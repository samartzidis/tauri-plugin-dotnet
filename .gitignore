# Rust
/target
Cargo.lock
/permissions/autogenerated
/permissions/schemas

# .NET
**/bin/
**/obj/
*.nupkg
# The Release backend built into src-tauri/backend by `beforeBuildCommand`, shipped by bundle.resources.
# An empty folder is created on demand by the first Debug build (tauri-build needs it to exist).
samples/*/src-tauri/backend/
# Backend bundles made by -p:TauriDotNetEmbed=true
*.tdnbundle
.vs/

# Node
node_modules/
dist-js/
dist/

# Samples: generated TypeScript bindings (created by `dotnet build`)
samples/*/src/bindings/

# Publishable build output (nupkg, crate) collected by CI/release targets
/artifacts

# Scratch clone made by update-public-repo.ps1
/.tauri-plugin-dotnet-export

# Tauri
/.tauri

# Editors / OS
.idea/
*.swp
*.user
.DS_Store
Thumbs.db
Desktop.ini
