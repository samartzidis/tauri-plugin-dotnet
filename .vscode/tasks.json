{
    // Build and run tasks for the plugin and the SampleApp sample.
    // Run with Ctrl+Shift+B (build), "Tasks: Run Test Task", or "Tasks: Run Task".
    "version": "2.0.0",
    "tasks": [
        // ---- Plugin: .NET library and generator ----
        {
            "label": "dotnet: build library",
            "type": "shell",
            "command": "dotnet build dotnet/Tauri.Plugin.DotNet.slnx",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "dotnet: test",
            "type": "shell",
            "command": "dotnet test dotnet/Tauri.Plugin.DotNet.slnx",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "dotnet: build nupkg",
            "type": "shell",
            "command": "dotnet pack dotnet/src/Tauri.Plugin.DotNet/Tauri.Plugin.DotNet.csproj -c Release -o artifacts",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "group": "build"
        },

        // ---- Plugin: Rust crate ----
        {
            "label": "cargo: build plugin",
            "type": "shell",
            "command": "cargo build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc",
            "group": "build"
        },
        {
            "label": "cargo: test plugin",
            "type": "shell",
            "command": "cargo test",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc",
            "group": "test"
        },
        {
            // `cargo package` always writes to target/package; copy the .crate into the shared artifacts folder.
            // --allow-dirty: this is a local build step, not the real `cargo publish`.
            // --no-verify: tauri-plugin's build.rs regenerates permissions/autogenerated (gitignored) at build
            // time, which cargo's verify-by-rebuilding-the-tarball step flags as the build script writing outside
            // OUT_DIR. Skipping verify still produces the same .crate; it just skips that extra recompile.
            "label": "cargo: build crate",
            "type": "shell",
            "command": "cargo package --allow-dirty --no-verify; New-Item -ItemType Directory -Force -Path artifacts | Out-Null; Copy-Item target/package/*.crate artifacts -Force",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$rustc",
            "group": "build"
        },

        // ---- Sample app: SampleApp ----
        {
            "label": "sample: npm install",
            "type": "shell",
            "command": "npm install",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "problemMatcher": []
        },
        {
            // Builds the C# backend the host loads, and generates src/bindings for the frontend.
            "label": "sample: build backend",
            "type": "shell",
            "command": "dotnet build src-dotnet/SampleApp.Backend",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "problemMatcher": "$msCompile"
        },
        {
            // Needs the generated bindings, hence the backend build first.
            "label": "sample: build frontend",
            "type": "shell",
            "command": "npm run build",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "dependsOn": ["sample: build backend"],
            "problemMatcher": "$tsc"
        },
        {
            // `custom-protocol` embeds the frontend; a plain cargo build would load devUrl instead.
            "label": "sample: build app",
            "type": "shell",
            "command": "cargo build --features custom-protocol",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp/src-tauri" },
            "dependsOn": ["sample: build frontend"],
            "problemMatcher": "$rustc",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "sample: run app",
            "type": "shell",
            "command": "cargo run --features custom-protocol",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp/src-tauri" },
            "dependsOn": ["sample: build frontend"],
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        // ---- Sample app with the backend embedded in the executable (optional; see the README) ----
        {
            // Also writes SampleApp.Backend.tdnbundle into bin\Debug\net8.0, which the `embedded-backend` feature includes.
            "label": "sample: build backend (embedded bundle)",
            "type": "shell",
            "command": "dotnet build src-dotnet/SampleApp.Backend -p:TauriDotNetEmbed=true",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "sample: build frontend (embedded)",
            "type": "shell",
            "command": "npm run build",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "dependsOn": ["sample: build backend (embedded bundle)"],
            "problemMatcher": "$tsc"
        },
        {
            "label": "sample: build app (embedded backend)",
            "type": "shell",
            "command": "cargo build --features custom-protocol,embedded-backend",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp/src-tauri" },
            "dependsOn": ["sample: build frontend (embedded)"],
            "problemMatcher": "$rustc",
            "group": "build"
        },
        {
            "label": "sample: run app (embedded backend)",
            "type": "shell",
            "command": "cargo run --features custom-protocol,embedded-backend",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp/src-tauri" },
            "dependsOn": ["sample: build frontend (embedded)"],
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        // ---- The single-file exe: a Release build with the backend embedded ----
        {
            // Release assemblies, bundled into bin\Release\net8.0\SampleApp.Backend.tdnbundle, which a release
            // cargo build embeds (the debug tasks above use the Debug folder's bundle).
            "label": "sample: build backend (embedded bundle, Release)",
            "type": "shell",
            "command": "dotnet build src-dotnet/SampleApp.Backend -c Release -p:TauriDotNetEmbed=true",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "sample: build frontend (embedded, Release)",
            "type": "shell",
            "command": "npm run build",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "dependsOn": ["sample: build backend (embedded bundle, Release)"],
            "problemMatcher": "$tsc"
        },
        {
            // Produces samples\SampleApp\src-tauri\target\release\sample-app.exe: one file, with the frontend
            // and the .NET backend inside. It still needs WebView2 and a .NET 8+ runtime on the machine.
            "label": "sample: build single-file exe (Release)",
            "type": "shell",
            "command": "cargo build --release --features custom-protocol,embedded-backend",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp/src-tauri" },
            "dependsOn": ["sample: build frontend (embedded, Release)"],
            "problemMatcher": "$rustc",
            "group": "build"
        },
        {
            "label": "sample: run single-file exe (Release)",
            "type": "shell",
            "command": "cargo run --release --features custom-protocol,embedded-backend",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp/src-tauri" },
            "dependsOn": ["sample: build frontend (embedded, Release)"],
            "problemMatcher": "$rustc",
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            // What tauri.conf.json is set up for (beforeDevCommand builds the backend, then starts Vite).
            "label": "sample: tauri dev",
            "type": "shell",
            "command": "npm run tauri dev",
            "options": { "cwd": "${workspaceFolder}/samples/SampleApp" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },

        // ---- Everything ----
        {
            "label": "test all",
            "dependsOn": ["dotnet: test", "cargo: test plugin"],
            "dependsOrder": "sequence",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
